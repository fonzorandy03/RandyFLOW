# Frontend Next.js: URL del backend Spring Boot, senza slash finale.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
# Valori ammessi: api oppure mock. In produzione usare sempre api.
NEXT_PUBLIC_DATA_MODE=api

# Backend Spring Boot / PostgreSQL locale.
DATABASE_URL=jdbc:postgresql://localhost:5433/randyflow
DATABASE_USERNAME=randyflow
DATABASE_PASSWORD=replace-with-a-local-secret
STORAGE_PATH=./backend/storage
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://randyflow.vercel.app
SERVER_PORT=8081
